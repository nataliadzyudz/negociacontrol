# NC Control Tower v2 - Backend
# Copiar este archivo a .env y completar los valores

# Puerto del servidor
PORT=3001

# Credenciales de Supabase
# Obtener de: Supabase Dashboard > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# NOTA: No usar SERVICE_ROLE_KEY aquí
# El backend usa ANON_KEY para operaciones seguras
# El paquete "ws" se requiere para Node.js 20 (WebSocket)