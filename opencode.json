                                            },
                                "enabled":  true
                            },
                "n8n-mcp-bridge":  {
                                        "type":  "local",
                                        "command":  [
                                                        "C:\\Program Files\\nodejs\\npx.cmd",
                                                        "-y",
                                                        "mcp-remote@latest",
                                                        "https://n8n-nc-n8n.wmd3t3.easypanel.host/mcp-server/http",
                                                        "--header",
                                                        "Authorization: Bearer ${AUTH_TOKEN}"
                                                    ],
