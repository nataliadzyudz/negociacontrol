{
    "$schema":  "https://opencode.ai/config.json",
    "mcp":  {
                "supabase":  {
                                 "type":  "remote",
                                 "url":  "https://mcp.supabase.com/mcp?project_ref=njzvqyovopcwfgwvnqli",
                                 "oauth":  {

                                           },
                                 "enabled":  true
                             },
                "n8n-mcp":  {
                                "type":  "remote",
                                "url":  "https://n8n-nc-n8n.wmd3t3.easypanel.host/mcp-server/http",
